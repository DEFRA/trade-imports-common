<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Defra.TradeImports.CdpUploader</AssemblyName>
    <RootNamespace>Defra.TradeImports.CdpUploader</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Defra.TradeImports.CdpUploader</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageDescription>Defra Trade Imports client for the CDP uploader (malware-scanned file uploads to S3)</PackageDescription>
    <Company>DEFRA</Company>
    <Authors>DEFRA</Authors>
    <RepositoryUrl>https://github.com/DEFRA/trade-imports-common</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference
      Include="Microsoft.Extensions.Options.ConfigurationExtensions"
      Version="10.0.3"
    />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Defra.TradeImports.CdpUploader.Tests" />
  </ItemGroup>
</Project>
